{
  "name": "papertrade-robinhood-lab",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node scripts/start.mjs",
    "compile": "node scripts/compile.mjs",
    "test": "node --test test/api.test.mjs",
    "up": "node scripts/daemon.mjs start",
    "down": "node scripts/daemon.mjs stop",
    "status": "node scripts/daemon.mjs status",
    "check": "node scripts/check.mjs",
    "seed:chart": "node scripts/seed-chart.mjs",
    "simulate:binance": "node scripts/binance-sim.mjs",
    "test:feed": "node --test test/binance.test.mjs",
    "test:showcase": "node --test --test-concurrency=1 test/showcase.test.mjs",
    "test:backend": "node --test --test-concurrency=1 test/backend.test.mjs",
    "build:backend": "cargo build --release --locked --manifest-path backend/Cargo.toml",
    "test:rust": "cargo test --locked --manifest-path backend/Cargo.toml",
    "bench:backend": "node scripts/benchmark-backend.mjs",
    "up:lan": "node scripts/lan.mjs start",
    "lan:feed": "node scripts/lan.mjs feed",
    "lan:status": "node scripts/lan.mjs status",
    "test:lan": "node --test test/lan.test.mjs",
    "qa:isolate": "python3 scripts/qa-isolate.py",
    "qa:extreme": "node scripts/qa-extreme.mjs"
  }
}
